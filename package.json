{
  "name": "lighthouse-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:data": "node src/data/generate.ts",
    "setup": "node src/agents/register.ts",
    "report": "node src/pipeline/run.ts",
    "approve": "node src/harness/cli.ts approve",
    "sessions": "node src/harness/cli.ts sessions",
    "schedule:run": "node src/harness/cli.ts schedule:run",
    "scheduler": "node src/harness/cli.ts scheduler",
    "eval": "node evals/run.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "mcp": "node src/mcp/server.ts",
    "demo": "node demo/serve.mjs",
    "demo:record": "node demo/record.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
